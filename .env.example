# ------------------------------------------------------------------------------
# Copy to `.env` and fill in what you use:  cp .env.example .env
#
# ONE RULE, and it has bitten this project three times: KEEP EVERY VALUE ALONE
# ON ITS LINE. A trailing `# comment` after a value is captured AS PART OF THE
# VALUE by some versions of Compose's env-file parser, and by `${VAR:-default}`
# interpolation. The failures are silent: an API key with a comment glued to it
# returns 401, and a URL that became a comment string makes a fail-open
# integration quietly stop doing anything. Comments go on their own line, above.
# ------------------------------------------------------------------------------

# Which config profile to load:
#   production  the VPS deployment: accounts + limits ON, DeepSeek/Qwen/Gemini
#               chat with automatic failover, Cohere embeddings + rerank,
#               DuckDB vectors
#   api         cloud providers (Anthropic/Voyage/Gemini), auth OFF
#   local       Ollama + open models, everything on your machine, auth OFF
#
# WARNING: `local` and `api` disable authentication — any caller can act as any
# user via the X-User-Id header. They are development profiles. Anything
# reachable from a network wants `production`.
# Copy this file to `.env` and fill it in. `.env` is gitignored and must stay
# that way — see CONTRIBUTING.md for what else this repo deliberately does not
# carry, and how to produce your own.
GRAPHRAG_PROFILE=production

# ONE-CHANGE LLM TOGGLE: flip the reply LLM between local and API without
# touching the profile. "provider:model" — provider is one of
# ollama | anthropic | openai | gemini | deepseek | qwen. Only the chat LLM
# changes; embeddings/OCR/rerank stay on the profile, so your ingested vectors
# stay valid (switching profiles instead swaps the embedder and needs re-ingest).
# Setting this REPLACES the profile's failover chain with the single model named
# here, so leave it empty in production.
# Examples:
#   GRAPHRAG_LLM=ollama:gemma4:e4b-it-q4_K_M
#   GRAPHRAG_LLM=deepseek:deepseek-v4-flash
GRAPHRAG_LLM=

# --- Infrastructure (defaults match docker-compose) ---------------------------
# In Docker these are overridden by docker-compose.yml to the service names;
# the values here are for running the API bare on your machine.
GRAPHRAG_NEO4J_URI=bolt://localhost:7687
GRAPHRAG_NEO4J_USER=neo4j

# SET BOTH PASSWORDS BEFORE THE FIRST `make up`. Postgres and Neo4j bake their
# password in when their data volume is first created; changing these later
# does not change the stored password, and every connection then fails auth.
GRAPHRAG_NEO4J_PASSWORD=please-change-me
GRAPHRAG_POSTGRES_PASSWORD=change-me

GRAPHRAG_REDIS_URL=redis://localhost:6379/0

# Postgres: accounts, limits, usage, chat history, and durable agent memory.
# Required by the `production` profile.
GRAPHRAG_DATABASE_URL=postgresql+asyncpg://graphrag:change-me@localhost:5432/graphrag

# --- Local runtime (Ollama) ---------------------------------------------------
GRAPHRAG_OLLAMA_BASE_URL=http://localhost:11434
# Inside Docker the containers default to the Ollama on your host
# (host.docker.internal). To use the bundled service instead
# (docker compose --profile local up), set this to http://ollama:11434
GRAPHRAG_OLLAMA_BASE_URL_INTERNAL=

# --- Auth & accounts ----------------------------------------------------------
# Break-glass admin key (header X-Admin-Key). Works even with no admin account.
# Leave empty unless you need it; it bypasses the account system by design.
GRAPHRAG_ADMIN_KEY=

# This account is promoted to admin at startup if it exists — sign up with it
# first, then restart (or run `make admin EMAIL=...`) to claim admin.
GRAPHRAG_ADMIN_EMAIL=

# --- Email delivery (verification codes) --------------------------------------
# With open registration ON, every signup needs its code delivered, so this is
# load-bearing rather than optional. With NEITHER key set, codes are only
# written to the server log — enough for your own first admin login, useless
# for anyone else.
#
# The sender address decides who can receive mail. Resend's shared
# `onboarding@resend.dev` only delivers to the address your Resend account is
# registered under, so real signups silently dead-end. Verify your own domain
# in Resend (Domains -> Add Domain, then add the DNS records) and send from it.
# `scripts/preflight.py` fails the deployment if this is still the shared sender
# while open registration is on.
GRAPHRAG_EMAIL_FROM=GraphRAG <noreply@example.com>
RESEND_API_KEY=
BREVO_API_KEY=

# --- API keys -----------------------------------------------------------------
# The production profile chains providers so one dead key degrades the service
# instead of stopping it:
#   chat/extraction   deepseek -> qwen -> gemini
#   OCR               gemini -> qwen -> tesseract (local, no key)
#   rerank            cohere -> deepseek -> qwen
#   embeddings        cohere ONLY — no fallback, by design. A different
#                     embedding model puts text in a different vector space, so
#                     falling back would corrupt the index instead of failing.
# So COHERE_API_KEY is required, and you want at least one working chat key.
# Run `python scripts/preflight.py` to see which links are actually live.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# DeepInfra: open-weight chat models AND embeddings behind one
# OpenAI-compatible endpoint. Named DEEPINFRA_TOKEN to match their docs;
# DEEPINFRA_API_KEY works too. Worth knowing if you want a self-contained
# setup: it serves models under their upstream ids, so `BAAI/bge-m3` there is
# the same weights as `BAAI/bge-m3` run locally — which makes it the one cloud
# embedder you can legally fail over. See docs/PROVIDERS.md.
DEEPINFRA_TOKEN=

# --- Guardrails safety service ------------------------------------------------
# The compose overlay sets the URL to the service name, so leave this empty
# unless you point at a guardrails running somewhere else.
GRAPHRAG_GUARDRAILS_URL=
# Only if the guardrails server sets GUARD_API_KEY.
GRAPHRAG_GUARDRAILS_API_KEY=

# The guardrails judge is a separate service with NO env_file, so it cannot see
# the keys above — its credentials must be passed explicitly here.
#
# GUARD_LLM_BASE_URL MUST be set: the compose overlay defaults it to Ollama, and
# that default overrides the named preset's own endpoint. Leaving it empty sends
# a DeepSeek request to Ollama and gets "model not found".
#
# `mock` is offline and free but screens nothing. Anything reachable from the
# network wants a real judge.
GUARD_LLM_PROVIDER=deepseek
GUARD_LLM_MODEL=deepseek-v4-flash
GUARD_LLM_BASE_URL=https://api.deepseek.com/v1
GUARD_LLM_API_KEY=

# Judges tried in order after the primary, as "provider:model,provider:model".
# Worth setting even if you set nothing else here: the guard FAILS OPEN, so a
# judge that stops answering does not raise anything — every verdict becomes
# `judge_unavailable` and requests pass unscreened while the service reports
# healthy. Put the links on DIFFERENT VENDORS; a second model behind the same
# key shares the outage.
#
# Each link resolves its own key from that preset's native env var
# (COHERE_API_KEY, GEMINI_API_KEY, ...), which the compose overlay forwards to
# the guardrails container. Links without one are dropped at startup — check
# what survived with:  curl -s localhost:8080/health | jq .chain
GUARD_LLM_FALLBACKS=

# Per-link timeout, and the ceiling across the whole chain including the repair
# retry. Set the total whenever you configure fallbacks: otherwise three links
# can run for 3x the per-link timeout, outlasting `safety.timeout_s` in your
# profile — at which point the caller has already given up and failed open.
# Keep safety.timeout_s > GUARD_LLM_TOTAL_TIMEOUT_S.
GUARD_LLM_TIMEOUT_S=10
GUARD_LLM_TOTAL_TIMEOUT_S=

# Consecutive failures that park a judge link, and for how long. A parked link
# is still tried when every other link is down too.
GUARD_LLM_FAILOVER_MAX_FAILURES=2
GUARD_LLM_FAILOVER_COOLDOWN_S=300

# What the guard does when EVERY judge is unreachable:
#   open    pass, deterministic rules only
#   flag    pass, but mark the verdict (the default)
#   closed  refuse the request — the strict choice for a public deployment
#           that would rather turn questions away than serve them unscreened
GUARD_FAIL_MODE=flag

# --- Compose file selection ---------------------------------------------------
# Base stack + guardrails. llmlens observability is deliberately NOT included:
# it adds ClickHouse + its own Redis + api/worker/dashboard, roughly another
# 4.6 GB of limits. That still does not fit on 12 GB — 7.6 + 4.6 is 12.2 GB of
# caps with nothing left for the OS — so adding it means either a 16 GB box or
# cutting the caps above first (ClickHouse is the expensive part).
# To add it later, append COMPOSE_PROFILES=observability and set
# observability.enabled in the profile.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.integrations.yml

# --- llmlens credentials (observability profile ONLY — unused otherwise) ------
# Dedicated credentials for the llmlens stack. The Postgres role owns only the
# `llmlens` database; never reuse GRAPHRAG_POSTGRES_PASSWORD here — the point
# is that the observability stack cannot read the accounts database.
LLMLENS_POSTGRES_PASSWORD=
LLMLENS_CLICKHOUSE_PASSWORD=

# --- Uploads ------------------------------------------------------------------
# Caddy rejects bodies larger than this before they reach the API. Keep it
# STRICTLY ABOVE api.max_upload_mb in configs/*.yaml (25 there, hence 26 here),
# or a big upload dies as a bare 413 without the API's own explanation.
#
# Strictly above, not equal: this caps the whole multipart BODY, while the API
# caps the file inside it. Set both to 25 and a file of exactly 25 MB — the
# size the API's own error message says is allowed — is refused here, because
# the boundaries and part headers push the body past the cap. The 1 MB gap is
# far more than that overhead (a few hundred bytes) and costs nothing.
MAX_UPLOAD_MB=26

# --- Reverse proxy / TLS ------------------------------------------------------
# One Caddy serves everything: TLS, the chat app at /, the admin console at
# /admin, and the API at /api.
#
# :80              plain HTTP (local dev only — session cookies travel in clear)
# localhost        HTTPS via Caddy's local self-signed CA
# rag.example.com  HTTPS via automatic Let's Encrypt (set TLS_EMAIL)
#
# For a real domain: the A record must already point at this box and ports
# 80/443 must be open, or Caddy cannot complete the ACME challenge and no
# certificate is issued.
SITE_ADDRESS=:80
TLS_EMAIL=

# A SECOND hostname that should redirect (308) to SITE_ADDRESS — set this to
# the apex if you serve at www, or to www if you serve at the apex. It needs
# its own A record and its own certificate, so point it at this box too.
#
# Do NOT instead list both names in SITE_ADDRESS. The session cookie is
# host-only (no Domain attribute), so two live hostnames means two separate
# sessions: a user signs in at www, later types the bare domain, and arrives
# signed out holding a session the browser will not send. Nothing errors.
#
# Leave EMPTY for a single-hostname deployment.
REDIRECT_FROM=

# --- Resource controls (per-container RAM / CPU caps) -------------------------
# These target a 4 vCPU / 12 GB VPS. The base stack plus guardrails sums to
# ~7.6 GB of limits, leaving ~4 GB for the OS and page cache. Memory as e.g.
# 4g/512m; CPU as a number of cores.
#
# The free memory is not slack. `data/vectors/*.duckdb` is read through the
# host page cache, so RAM the containers do not claim is what keeps a tenant's
# vector scan off the disk — and a `docker compose build` (two `npm ci` + vite)
# wants a GB or so of its own. Handing the last 4 GB to container caps would
# make queries slower, not faster.
#
# The CPU limits deliberately sum to more than 4: they are ceilings that stop
# one service starving the others, not reservations.
API_MEM_LIMIT=3g
API_CPU_LIMIT=3
NEO4J_MEM_LIMIT=2560m
NEO4J_CPU_LIMIT=2
# Heap + pagecache must fit under NEO4J_MEM_LIMIT with room for the JVM itself
# (metaspace, thread stacks, direct buffers — allow ~500m). 1g + 768m under
# 2560m leaves ~800m.
NEO4J_HEAP=1g
NEO4J_PAGECACHE=768M
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=1
REDIS_MEM_LIMIT=384m
# Below the container cap on purpose: maxmemory bounds the keyspace, and
# fragmentation plus copy-on-write during a fork sit on top of it. A maxmemory
# equal to the cap gets the process OOM-killed instead of evicting.
REDIS_MAXMEMORY=288mb
# The proxy now also serves both web apps' static files (the separate nginx
# container is gone), so this covers what FRONTEND_MEM_LIMIT used to.
PROXY_MEM_LIMIT=256m
PROXY_CPU_LIMIT=1
# A full core: the guard is in the path of every /query, so time it spends
# waiting for CPU is added to every answer.
GUARDRAILS_MEM_LIMIT=512m
GUARDRAILS_CPU_LIMIT=1

# Only used with `--profile worker` (separate ingest process; incompatible with
# the duckdb vector provider, which requires single-process ownership).
WORKER_MEM_LIMIT=1g
WORKER_CPU_LIMIT=1

# Only used with `--profile local` (the bundled Ollama).
OLLAMA_MEM_LIMIT=8g
OLLAMA_CPU_LIMIT=4

# --- Concurrency / CPU-thread caps -------------------------------------------
# 1 = dispatch ingest to the arq worker service. Leave 0 with the duckdb vector
# provider: the API process must own each tenant's database file.
GRAPHRAG_USE_WORKER=0
# Parallel ingest jobs per worker.
GRAPHRAG_WORKER_CONCURRENCY=2
# CPU threads for local model math. Moot on the production profile (Cohere does
# the embedding, no torch is installed); it caps the fan-out if you ever build
# with the local-models extra.
OMP_NUM_THREADS=3
